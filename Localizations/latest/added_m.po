msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_HEADER"
msgstr "精通"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_1_HEADER"
msgstr "精通等级"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_1_TEXT_1"
msgstr "精通等级反映了您对特定战舰的熟练程度及战斗经验。精通等级显示在战舰名称旁边。"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_1_TEXT_2"
msgstr "仅适用于VIII-X级和超级战舰。"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_2_HEADER"
msgstr "进度"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_2_TEXT_1"
msgstr "要提升到下一个精通等级，您需要获得足够的基础经验。"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_2_TEXT_2"
msgstr "战舰等级和当前精通等级越高，提升精通等级所需的基础经验越多。"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_3_HEADER"
msgstr "挑战"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_3_TEXT_1"
msgstr "每过10个精通等级，当您想继续升级时，需要完成专为战舰设计的精通挑战任务。您可以随时重置精通挑战并获得新的挑战任务。"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_3_TEXT_2"
msgstr "您最多可以同时对15艘战舰进行精通挑战。考虑到完成难度，在联合作战和行动中取得的成果被计入精通挑战任务时减半。"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_4_HEADER"
msgstr "综合精通"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_4_TEXT_1"
msgstr "您所有战舰的精通等级将被累计以得出您的综合精通等级。"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_4_TEXT_2"
msgstr "这个过程是自动进行的，不需要您完成额外的精通挑战。"

msgid "IDS_NAVAL_FLAG_CAO_WEI"
msgstr "曹魏水师"

msgid "IDS_NAVAL_FLAG_CAO_WEI_DESCRIPTION"
msgstr "魏国是公元3世纪争霸古中国的三国之一。魏国的建立者是曹操，他是一位政治家，在汉王朝衰落时曾实际统治过汉王朝。皇帝赐给曹操十城之地，这就是后来的魏国。"

msgid "IDS_NAVAL_FLAG_DONG_WU"
msgstr "东吴水师"

msgid "IDS_NAVAL_FLAG_DONG_WU_DESCRIPTION"
msgstr "吴国是公元3世纪争霸古中国的三国之一。吴国的统治者孙权据说是著名的《孙子兵法》作者孙武的后代。孙权在继承了兄长的土地后自立为帝，成为三国时期著名的三位领袖中最年轻的一位。"

msgid "IDS_NAVAL_FLAG_SHU_HAN"
msgstr "蜀汉水师"

msgid "IDS_NAVAL_FLAG_SHU_HAN_DESCRIPTION"
msgstr "蜀国是公元3世纪争霸古中国的三国之一。其名称“蜀”来源于周朝时期的同名国家，位于大致相同的区域。蜀国的建立者刘备自称与汉朝王室有血缘关系，是汉朝的合法继承人。"

msgid "IDS_NEWBIE_QUESTS_BATTLE_ICON_HINT"

msgid "IDS_GUIDING_TIP_276_HEADER"
msgstr "选定战略行动"

msgid "IDS_GUIDING_TIP_277_DESC"
msgstr "每场战略行动包含多个任务——单场战斗中只能完成其中一项。当前任务随每次战斗而改变。"

msgid "IDS_GUIDING_TIP_278_DESC"

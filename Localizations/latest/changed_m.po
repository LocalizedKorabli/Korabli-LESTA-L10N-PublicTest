msgid "IDS_DOCK_CONSUME_DESCRIPTION_PXY511_2025WT_ADDDD"
msgstr "<p>召唤无人驱逐舰<b>秋月</b>。</p><p class=\"p_spacing\"> </p><p>进入战斗后，无人舰会为您的战舰提供<u>武器射速+5%</u>的永久加成。相同无人舰的加成可叠加。</p><p class=\"p_spacing\"> </p><p>每次使用都会消耗1次“信号”类型消耗品的装载数，后者则可通过“信号发生器”作战指令补充。</p><p class=\"p_spacing\"> </p><p>将准星对准敌方战舰并按下[KEY_F3]，无人舰将集中火力攻击此战舰。</p>"

msgid "IDS_DOCK_CONSUME_DESCRIPTION_PXY512_2025WT_ADDCR"
msgstr "<p>召唤无人巡洋舰<b>妙高</b>。</p><p class=\"p_spacing\"> </p><p>进入战斗后，无人舰会为您的战舰提供<u>最大生命值+2%</u>的永久加成。相同无人舰的加成可叠加。</p><p class=\"p_spacing\"> </p><p>每次使用都会消耗1次“信号”类型消耗品的装载数，后者则可通过“信号发生器”作战指令补充。</p><p class=\"p_spacing\"> </p><p>将准星对准敌方战舰并按下[KEY_F3]，无人舰将集中火力攻击此战舰。</p>"

msgid "IDS_DOCK_CONSUME_DESCRIPTION_PXY513_2025WT_ADDBB"
msgstr "<p>召唤无人战列舰<b>扶桑</b>。</p><p class=\"p_spacing\"> </p><p>进入战斗后，无人舰会为您的战舰提供<u>每秒恢复30点生命值</u>的永久加成。相同无人舰的加成可叠加。</p><p class=\"p_spacing\"> </p><p>每次使用都会消耗1次“信号”类型消耗品的装载数，后者则可通过“信号发生器”作战指令补充。</p><p class=\"p_spacing\"> </p><p>将准星对准敌方战舰并按下[KEY_F3]，无人舰将集中火力攻击此战舰。</p>"

msgid "IDS_DOCK_CONSUME_DESCRIPTION_PXY520_2025WT_HOUNDSMASSHEAL"
msgstr "立刻为队伍中每艘战舰恢复7500点生命值。"

msgid "IDS_DOCK_CONSUME_DESCRIPTION_PXY521_2025WT_HOUNDSSPEEDBOOSTER"
msgstr "提高队伍中所有战舰的航速和机动性。"

msgid "IDS_DOCK_CONSUME_DESCRIPTION_PXY527_2025WT_WT3_TELEPORT"
msgstr "将战舰与所有已召唤的无人舰一同传送至一个随机猎犬的位置。"

msgid "IDS_DOCK_CONSUME_DESCRIPTION_PXY529_2025WT_DONORPARTS"
msgstr "对您召唤的所有无人舰造成5000点伤害，并将这些伤害转化为您战舰的生命值。"

msgid "IDS_DOCK_CONSUME_DESCRIPTION_PXY535_2025WT_HOUNDSSUPERDESPERATE"
msgstr "在启用期间，以自身受到持续伤害的代价，提高所有类型武器的射速和伤害。"

msgid "IDS_DOCK_CONSUME_DESCRIPTION_PXY539_2025WT_HOUNDSALTMASSHEAL"
msgstr "消耗品启用一瞬间使您战舰失去相当于其基础生命值50%的生命值，之后每秒为您队伍中的每艘战舰恢复400点生命值。"

msgid "IDS_DOCK_CONSUME_DESCRIPTION_PXY540_2025WT_ADDDD2"
msgstr "<p>召唤无人驱逐舰<b>哥萨克人</b>。</p><p class=\"p_spacing\"> </p><p>进入战斗后，无人舰会为您所有存活的无人舰提供<u>武器射速+10%</u>的永久加成。相同无人舰的加成可叠加。</p><p class=\"p_spacing\"> </p><p>每次使用都会消耗1次“信号”类型消耗品的装载数，后者则可通过“信号发生器”作战指令补充。</p><p class=\"p_spacing\"> </p><p>将准星对准敌方战舰并按下[KEY_F3]，无人舰将集中火力攻击此战舰。</p>"

msgid "IDS_DOCK_CONSUME_DESCRIPTION_PXY541_2025WT_ADDCR2"
msgstr "<p>召唤无人巡洋舰<b>萨里</b>。</p><p class=\"p_spacing\"> </p><p>进入战斗后，无人舰会为您所有存活的无人舰提供<u>最大生命值+10%</u>的永久加成。相同无人舰的加成可叠加。</p><p class=\"p_spacing\"> </p><p>每次使用都会消耗1次“信号”类型消耗品的装载数，后者则可通过“信号发生器”作战指令补充。</p><p class=\"p_spacing\"> </p><p>将准星对准敌方战舰并按下[KEY_F3]，无人舰将集中火力攻击此战舰。</p>"

msgid "IDS_DOCK_CONSUME_DESCRIPTION_PXY542_2025WT_ADDBB2"
msgstr "<p>召唤无人战列舰<b>英王乔治五世</b>。</p><p class=\"p_spacing\"> </p><p>进入战斗后，无人舰会为您所有存活的无人舰提供<u>每秒恢复40点生命值</u>的永久加成。相同无人舰的加成可叠加。</p><p class=\"p_spacing\"> </p><p>每次使用都会消耗1次“信号”类型消耗品的装载数，后者则可通过“信号发生器”作战指令补充。</p><p class=\"p_spacing\"> </p><p>将准星对准敌方战舰并按下[KEY_F3]，无人舰将集中火力攻击此战舰。</p>"

msgid "IDS_DOCK_CONSUME_DESCRIPTION_PXY543_2025WT_ADDDD3"
msgstr "<p>召唤无人驱逐舰<b>G.J.梅克尔</b>。</p><p class=\"p_spacing\"> </p><p>只要无人舰存活，就会为您的战舰及您所有存活的无人舰提供<u>武器射速+15%</u>的永久加成。相同无人舰的加成可叠加。</p><p class=\"p_spacing\"> </p><p>每次使用都会消耗1次“信号”类型消耗品的装载数，后者则可通过“信号发生器”作战指令补充。</p><p class=\"p_spacing\"> </p><p>将准星对准敌方战舰并按下[KEY_F3]，无人舰将集中火力攻击此战舰。</p>"

msgid "IDS_DOCK_CONSUME_DESCRIPTION_PXY544_2025WT_ADDCR3"
msgstr "<p>召唤无人巡洋舰<b>约克</b>。</p><p class=\"p_spacing\"> </p><p>只要无人舰存活，就会为您的战舰及您所有存活的无人舰提供<u>每秒恢复50点生命值</u>的永久加成。相同无人舰的加成可叠加。</p><p class=\"p_spacing\"> </p><p>每次使用都会消耗1次“信号”类型消耗品的装载数，后者则可通过“信号发生器”作战指令补充。</p><p class=\"p_spacing\"> </p><p>将准星对准敌方战舰并按下[KEY_F3]，无人舰将集中火力攻击此战舰。</p>"

msgid "IDS_DOCK_CONSUME_DESCRIPTION_PXY545_2025WT_ADDBB3"
msgstr "<p>召唤无人战列舰<b>马肯森</b>。</p><p class=\"p_spacing\"> </p><p>进入战斗后，无人舰会为您的战舰及您所有存活的无人舰<u>一次性恢复5000点生命值</u>。相同无人舰的加成可叠加。</p><p class=\"p_spacing\"> </p><p>每次使用都会消耗1次“信号”类型消耗品的装载数，后者则可通过“信号发生器”作战指令补充。</p><p class=\"p_spacing\"> </p><p>将准星对准敌方战舰并按下[KEY_F3]，无人舰将集中火力攻击此战舰。</p>"


msgid "IDS_GUIDING_TIP_279_DESC"
msgstr "战略行动全部完成后，可领取最终奖励。"

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_PARAGRAPH_1_TEXT_1"
msgstr "您港口中的III级到超级战舰，都可以获得节日奖励。要从战舰上领取奖励，您需要驾驶它进入战斗并获取300点基础经验或赢得一场战斗。"

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_PARAGRAPH_3_TEXT_1"
msgstr ""
"50艘战舰：获得350点基础经验，奖励+1；\n"
"100艘战舰：获得400点基础经验，奖励+2；\n"
"200艘战舰：获得500点基础经验，奖励+3；\n"
"300艘战舰：获得600点基础经验，奖励+4；\n"
"400艘战舰：获得700点基础经验，奖励+5；\n"
"500艘战舰：获得800点基础经验，奖励+6；\n"
"600艘战舰：获得1000点基础经验，奖励+7。"

msgid "IDS_NEWBIE_QUESTS_PCON015_DESCRIPTION"

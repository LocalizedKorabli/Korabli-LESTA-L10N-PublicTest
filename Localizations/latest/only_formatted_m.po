msgid "IDS_PCZC150_HSF_AKANE_KINESAKI_DESCRIPTION"
msgstr "<p><h3>职务：</h3>给养员/水雷运用员/炊事委员</p><p class=\"p_spacing\"> </p><p><h3>兴趣/特长：</h3>制作日式甜点，打游戏</p><p class=\"p_spacing\"> </p><p><h3>喜欢的食物：</h3>奶油炖菜</p><p class=\"p_spacing\"> </p><p><h3>不喜欢的食物：</h3>米糠酱菜</p><p class=\"p_spacing\"> </p><p><h3>擅长科目：</h3>家政(料理、营养)</p><p class=\"p_spacing\"> </p><p><h3>不擅长科目：</h3>全部社会科</p><p class=\"p_spacing\"> </p><p><h3>口头禅：</h3>“革命战士”</p><p class=\"p_spacing\"> </p><p><h3>性格：</h3>健忘</p>"

msgid "IDS_PCZC151_HSF_MIKAN_IRAKO_DESCRIPTION"
msgstr "<p><h3>职务：</h3>给养员/炮水雷运用员/炊事委员</p><p class=\"p_spacing\"> </p><p><h3>兴趣/特长：</h3>拍照、电视鉴赏(热爱电视剧)</p><p class=\"p_spacing\"> </p><p><h3>喜欢的食物：</h3>意式料理、日本传统料理</p><p class=\"p_spacing\"> </p><p><h3>不喜欢的食物：</h3>泡面</p><p class=\"p_spacing\"> </p><p><h3>擅长科目：</h3>家政(料理、营养)</p><p class=\"p_spacing\"> </p><p><h3>不擅长科目：</h3>日语</p><p class=\"p_spacing\"> </p><p><h3>口头禅：</h3>“不忘憧憬便能使其成为现实”</p><p class=\"p_spacing\"> </p><p><h3>性格：</h3>强迫症</p>"

msgid "IDS_PCZC152_HSF_TOUMATSU_MIMI_DESCRIPTION"

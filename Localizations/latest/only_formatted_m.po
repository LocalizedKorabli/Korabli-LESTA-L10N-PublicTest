msgid "IDS_PCZC148_HSF_AOKI_MOMO_DESCRIPTION"
msgstr "<p><h3>职务：</h3>应急员/美化委员</p><p class=\"p_spacing\"> </p><p><h3>兴趣/特长：</h3>画漫画、裁缝</p><p class=\"p_spacing\"> </p><p><h3>喜欢的食物：</h3>全部蛋料理、生蛋拌饭也很喜欢</p><p class=\"p_spacing\"> </p><p><h3>不喜欢的食物：</h3>沙丁鱼</p><p class=\"p_spacing\"> </p><p><h3>擅长科目：</h3>技术(工程)、家政(服装)</p><p class=\"p_spacing\"> </p><p><h3>不擅长科目：</h3>英语</p><p class=\"p_spacing\"> </p><p><h3>口头禅：</h3>“所有东西只要打磨就会发光”</p><p class=\"p_spacing\"> </p><p><h3>性格：</h3>一旦开始看漫画就会忘记其他的事</p>"

msgid "IDS_PCZC149_HSF_HOMARE_KINESAKI_DESCRIPTION"

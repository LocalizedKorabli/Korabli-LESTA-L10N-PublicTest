msgid "IDS_TRIAL_MAN_TEXT_RADIUS_VISIBILITY_1"
msgstr "Если противник окажется внутри радиуса вашей заметности, он обнаружит вас и будет атаковать"

msgid "IDS_TRIAL_MAN_TEXT_RADIUS_VISIBILITY_2"

msgid "IDS_PARAGONS_DROP_BRANCH_BONUS_BLOCK_0"
msgstr "На каждый сброшенный корабль V–X уровня будут начислены очки исследования. Чтобы их получить, нужно исследовать корабль заново, купить его, а затем, выйдя на нём в бой, победить или набрать 300 ед. чистого опыта."

msgid "IDS_PARAGONS_DROP_BRANCH_BONUS_BLOCK_1"

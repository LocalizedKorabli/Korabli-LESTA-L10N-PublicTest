msgstr "ОГНЕВАЯ МОЩЬ"

msgid "IDS_TRIAL_DAMAGE_DESCRIPTION"
msgstr "Наносите урон"

msgid "IDS_TRIAL_DAMAGE_FULL_DESCRIPTION"

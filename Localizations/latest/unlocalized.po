msgid "IDS_TRIAL_FRAG_PRIME_PHASE2_ANNONCEMENT"
msgstr "Уничтожайте корабли до того, как они успеют выстрелить!"

msgid "IDS_TRIAL_FRAG_PRIME_PHASE3A_ANNONCEMENT"

msgid "IDS_MODAL_WINDOW_POSTBATTLE_RESULTS_TITLE"
msgstr "Награда за бой"

msgid "IDS_MODAL_WINDOW_PURCHASE_AND_LINK_MULTIBOOST"
msgstr "Купить бонусы"

msgid "IDS_MODAL_WINDOW_PVEBATTLE_RULES_HEADER"
msgstr "Операции"

msgid "IDS_MODAL_WINDOW_PVEBATTLE_RULES_PARAGRAPH_1_HEADER"
msgstr "Особенности боя"

msgid "IDS_MODAL_WINDOW_PVEBATTLE_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Вам предстоит сразиться с другими игроками против ботов. Каждая Операция обладает уникальными сюжетными элементами."

msgid "IDS_MODAL_WINDOW_PVEBATTLE_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Операция выбирается случайным образом. Сложность зависит от уровней и классов кораблей в вашей команде."

msgid "IDS_MODAL_WINDOW_PVEBATTLE_RULES_PARAGRAPH_2_HEADER"
msgstr "Задачи"

msgid "IDS_MODAL_WINDOW_PVEBATTLE_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Чтобы одержать победу, вашей команде необходимо достигнуть основной цели."

msgid "IDS_MODAL_WINDOW_PVEBATTLE_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Чем больше дополнительных задач вы выполните в ходе Операции, тем больше ресурсов вы получите."

msgid "IDS_MODAL_WINDOW_RANDOMBATTLE_RULES_HEADER"
msgstr "Случайный бой"

msgid "IDS_MODAL_WINDOW_RANDOMBATTLE_RULES_PARAGRAPH_1_HEADER"
msgstr "Особенности боя"

msgid "IDS_MODAL_WINDOW_RANDOMBATTLE_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Вам предстоит сразиться вместе с другими игроками в битве между двумя командами."

msgid "IDS_MODAL_WINDOW_RANDOMBATTLE_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Карта и режим боя подбираются случайным образом."

msgid "IDS_MODAL_WINDOW_RANDOMBATTLE_RULES_PARAGRAPH_2_HEADER"
msgstr "Условия участия"

msgid "IDS_MODAL_WINDOW_RANDOMBATTLE_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Максимальный размер команд: 12 на 12."

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_HEADER"
msgstr "Ранговый бой"

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_1_HEADER"
msgstr "Особенности боя"

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Вам предстоит сражаться с другими игроками, получая ранги и продвигаясь по лигам."

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Сезон Ранговых боёв делится на спринты. Ваш прогресс в лиге сбрасывается с началом каждого спринта."

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_2_HEADER"
msgstr "Условия сезона"

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Бронзовая лига"

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Серебряная лига"

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_2_TEXT_3"
msgstr "Золотая лига"

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_3_HEADER"
msgstr "Лиги и ранги"

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_3_TEXT_1"
msgstr "Для перехода в следующую лигу нужно получить 1-й ранг и пройти квалификацию."

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_3_TEXT_2"
msgstr "Чтобы получать ранги, необходимо зарабатывать звёзды."

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_4_HEADER"
msgstr "Звёзды"

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_4_TEXT_1"
msgstr "За победу вы получаете одну звезду. За поражение или ничью вы теряете одну звезду."

msgid "IDS_MODAL_WINDOW_RANKEDBATTLE_RULES_PARAGRAPH_4_TEXT_2"
msgstr "Вы не потеряете звезду, если по итогам боя займёте 1-е место в своей команде по заработанному опыту."

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_HEADER"
msgstr "Рейтинговый бой"

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_1_HEADER"
msgstr "Особенности боя"

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Вам предстоит сражаться с другими игроками, которые подбираются по рейтингу боевой эффективности."

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Рейтинг корректируется после каждого боя на основе его результата и полученного чистого опыта."

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_2_HEADER"
msgstr "Лиги и рейтинг"

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Прогресс в Рейтинговых боях сбрасывается каждый сезон. В начале сезона нужно провести 5 боёв, чтобы получить рейтинг в одной из лиг."

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Максимальный рейтинг в Железной, Бронзовой, Серебряной и Золотой лигах — 100. Превысив это значение в текущей лиге, вы перейдёте в следующую. В Обсидиановой лиге можно повышать рейтинг неограниченно."

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_3_HEADER"
msgstr "Отряды"

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_3_TEXT_1"
msgstr "Рейтинг отряда — средний рейтинг всех участников с повышающим коэффициентом за их количество. Чем больше участников в отряде, тем выше коэффициент."

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_3_TEXT_2"
msgstr "При подборе соперников учитывается как рейтинг игроков, так и рейтинг отрядов."

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_4_HEADER"
msgstr "Условия участия"

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_4_TEXT_1"
msgstr "Состав команд может меняться в зависимости от сезона."

msgid "IDS_MODAL_WINDOW_RATINGBATTLE_RULES_PARAGRAPH_4_TEXT_2"
msgstr "Вы можете выйти в бой в одиночку или в составе отряда. Размер отряда ограничен только размером команды."

msgid "IDS_MODAL_WINDOW_RULES_TAB_NAME_0"
msgstr "Правила"

msgid "IDS_MODAL_WINDOW_RULES_TAB_NAME_1"
msgstr "Достижения"

msgid "IDS_MODAL_WINDOW_SEASON_RESTRICTIONS_TITLE"
msgstr "Ограничения на конкретные корабли"

msgid "IDS_MODAL_WINDOW_SHIPS_BRANCHES_FEATURES_TAB_BAR_MAIN"
msgstr "Основные"

msgid "IDS_MODAL_WINDOW_SHIPS_BRANCHES_FEATURES_TAB_BAR_OTHER"
msgstr "Подробные"

msgid "IDS_MODAL_WINDOW_SHIPS_BRANCHES_FEATURES_TITLE"
msgstr "Особенности кораблей"

msgid "IDS_MODAL_WINDOW_SHIP_BRANCH_FEATURES_TITLE"
msgstr "Особенности корабля"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_HEADER"
msgstr "Мастерство"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_1_HEADER"
msgstr "Уровень мастерства"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_1_TEXT_1"
msgstr "Мастерство отражает степень владения определённым кораблём и ваш боевой опыт на нём. Уровень мастерства отображается рядом с именем корабля."

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_1_TEXT_2"
msgstr "Доступно только для кораблей VIII–X уровней и суперкораблей."

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_2_HEADER"
msgstr "Прогресс"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Чтобы перейти на следующий уровень мастерства, нужно набрать определённое количество чистого опыта."

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Чем выше уровень корабля и уровень вашего мастерства на нём, тем больше чистого опыта нужно заработать, чтобы перейти на следующий уровень мастерства."

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_3_HEADER"
msgstr "Испытания"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_3_TEXT_1"
msgstr "Для перехода на каждый 10-й уровень мастерства нужно пройти испытания, которые подбираются специально для корабля. В любой момент вы можете сбросить испытания и получить новые."

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_3_TEXT_2"
msgstr "Одновременно можно взять испытания не более чем на 15 кораблях. Испытания учитывают половину результата в Кооперативных боях и Операциях."

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_4_HEADER"
msgstr "Общее мастерство"

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_4_TEXT_1"
msgstr "Ваше мастерство на всех кораблях складывается в общий уровень мастерства."

msgid "IDS_MODAL_WINDOW_SHIP_MASTERY_RULES_PARAGRAPH_4_TEXT_2"
msgstr "Это происходит автоматически, для повышения общего мастерства не нужно проходить испытания."

msgid "IDS_MODAL_WINDOW_SHIP_PURCHASE_SHIP_PRICE"
msgstr "Стоимость корабля:"

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_HEADER"
msgstr "Условия получения"

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_PARAGRAPH_1_HEADER"
msgstr "Как получать награды"

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_PARAGRAPH_1_TEXT_1"
msgstr "На каждый корабль в вашем Порту, от III уровня до суперкораблей, начислена праздничная награда. Чтобы забрать награду с корабля, нужно выйти на нём в бой и заработать 300 ед. чистого опыта или одержать победу."

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_PARAGRAPH_1_TEXT_2"
msgstr "По завершении события незабранные награды будут списаны без компенсации."

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_PARAGRAPH_2_HEADER"
msgstr "Больше наград за один бой"

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_PARAGRAPH_2_TEXT_1"
msgstr "Получив больше чистого опыта за бой на корабле с наградой, вы сможете забрать награды с других кораблей, не выходя на них в бой."

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_PARAGRAPH_2_TEXT_2"
msgstr "Чем больше кораблей в вашем Порту, тем больше максимальное количество наград, которое вы можете забрать по итогам одного боя."

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_PARAGRAPH_3_HEADER"
msgstr "Количество наград"

msgid "IDS_MODAL_WINDOW_SNOWFLAKES_RULES_PARAGRAPH_3_TEXT_1"
msgstr ""
"50 кораблей: +1 за 350 ед. опыта;\n"
"100 кораблей: +2 за 400 ед. опыта;\n"
"200 кораблей: +3 за 500 ед. опыта;\n"
"300 кораблей: +4 за 600 ед. опыта;\n"
"400 кораблей: +5 за 700 ед. опыта;\n"
"500 кораблей: +6 за 800 ед. опыта;\n"
"600 кораблей: +7 за 1 000 ед. опыта."

msgid "IDS_MODAL_WINDOW_SUBMARINE_TUTORIAL_HEADER"
msgstr "Управление подводной лодкой"

msgid "IDS_MODAL_WINDOW_SUBMARINE_TUTORIAL_PARAGRAPH_1_HEADER"
msgstr "Запас автономности"

msgid "IDS_MODAL_WINDOW_SUBMARINE_TUTORIAL_PARAGRAPH_1_TEXT_1"
msgstr "Необходим для нахождения под водой"

msgid "IDS_MODAL_WINDOW_SUBMARINE_TUTORIAL_PARAGRAPH_1_TEXT_2"
msgstr "Восстанавливается в надводном положении"

msgid "IDS_MODAL_WINDOW_SUBMARINE_TUTORIAL_PARAGRAPH_2_HEADER"
msgstr "Глубины"

msgid "IDS_MODAL_WINDOW_SUBMARINE_TUTORIAL_PARAGRAPH_2_TEXT_1"
msgstr "[CRUISE_DEEP_UP] Всплыть"

msgid "IDS_MODAL_WINDOW_SUBMARINE_TUTORIAL_PARAGRAPH_2_TEXT_2"
msgstr "[CRUISE_DEEP_DOWN] Погрузиться"

msgid "IDS_MODAL_WINDOW_SUBMARINE_TUTORIAL_PARAGRAPH_3_HEADER"
msgstr "Торпеды с акустическим наведением"

msgid "IDS_MODAL_WINDOW_SUBMARINE_TUTORIAL_PARAGRAPH_3_TEXT_1"
msgstr "Наводятся на сектор корабля, отмеченный импульсом сонара"

msgid "IDS_MODAL_WINDOW_SUBMARINE_TUTORIAL_PARAGRAPH_3_TEXT_2"
msgstr "Имеют повышенную манёвренность при наведении на цель с двукратно отмеченным сектором"

msgid "IDS_MODAL_WINDOW_SUBMARINE_TUTORIAL_PARAGRAPH_4_HEADER"
msgstr "Торпеды [UNUSED]"

msgid "IDS_MODAL_WINDOW_SUBMARINE_TUTORIAL_PARAGRAPH_4_TEXT_1"
msgstr "Наиболее эффективны против надводных целей. [UNUSED]"

msgid "IDS_MODAL_WINDOW_SUBMARINE_TUTORIAL_PARAGRAPH_4_TEXT_2"
msgstr "Наиболее эффективны против надводных целей. [UNUSED]"

msgid "IDS_MODAL_WINDOW_SUBS_IMPROVE_EVENT_1_PARAGRAPH_1_HEADER"
msgstr "ПОДВОДНЫЕ ЛОДКИ"

msgid "IDS_MODAL_WINDOW_SUBS_IMPROVE_EVENT_1_PARAGRAPH_1_TEXT_1"
msgstr "Когда подводная лодка пускает импульс сонара, на поверхности воды видны волны. Они показывают направление движения подводной лодки."

msgid "IDS_MODAL_WINDOW_SUBS_IMPROVE_EVENT_2_PARAGRAPH_2_HEADER"
msgstr "ШУМОПЕЛЕНГАЦИЯ"

msgid "IDS_MODAL_WINDOW_SUBS_IMPROVE_EVENT_2_PARAGRAPH_2_TEXT_1"
msgstr "Подводная лодка видит позиции надводных кораблей с определённого расстояния."

msgid "IDS_MODAL_WINDOW_SUBS_IMPROVE_EVENT_3_PARAGRAPH_3_HEADER"
msgstr "ГЛУБИННЫЕ БОМБЫ"

msgid "IDS_MODAL_WINDOW_SUBS_IMPROVE_EVENT_3_PARAGRAPH_3_TEXT_1"
msgstr "Удерживаются на небольшой глубине определённое время. Наносят урон подводным лодкам и уничтожают торпеды."

msgid "IDS_MODAL_WINDOW_SUBS_IMPROVE_EVENT_FOR_SUB_1_PARAGRAPH_1_HEADER"
msgstr "СОНАР И ТОРПЕДЫ"

msgid "IDS_MODAL_WINDOW_SUBS_IMPROVE_EVENT_FOR_SUB_1_PARAGRAPH_1_TEXT_1"
msgstr "Количество торпед одной подводной лодки, которые могут одновременно наводиться на корабль, ограниченно и зависит от класса."

msgid "IDS_MODAL_WINDOW_SUBS_IMPROVE_EVENT_FOR_SUB_2_PARAGRAPH_2_HEADER"
